{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./routers": {
      "types": "./src/routers/index.ts",
      "default": "./src/routers/index.ts"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "default": "./src/storage/index.ts"
    }
  },
  "scripts": {
    "seed": "bun --env-file=../../.env src/scripts/seed.ts",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file=../../.env dist/index.js",
    "test": "bun test",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "@orpc/server": "^1.14.10",
    "ai": "catalog:",
    "auth": "workspace:*",
    "cache": "workspace:*",
    "db": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-valibot": "catalog:",
    "env": "workspace:*",
    "hono": "^4.12.9",
    "nanoid": "catalog:",
    "transliteration": "catalog:",
    "utils": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yopem/typescript-config": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
