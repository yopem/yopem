{
  "extends": "@yopem/typescript-config/base",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "api-client": ["./src/index.ts"],
      "api-client/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
