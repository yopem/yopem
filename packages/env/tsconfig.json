{
  "extends": "@yopem/typescript-config/base",
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "types": ["node"],
    "rootDir": ".",
    "paths": {
      "env": ["./src/index.ts"],
      "env/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
}
